{
  "name": "devin-vscode",
  "displayName": "Devin for VS Code (Coder fork)",
  "description": "A native chat panel for the Devin CLI, powered by the Agent Client Protocol. Streaming replies, per workspace sessions, and trackable diffs.",
  "version": "0.13.9",
  "publisher": "wsj3000",
  "author": "Shayan Khaksar",
  "license": "AGPL-3.0-or-later",
  "preview": true,
  "icon": "resources/icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/wsj3000/devin-vscode.git"
  },
  "homepage": "https://github.com/wsj3000/devin-vscode#readme",
  "bugs": {
    "url": "https://github.com/wsj3000/devin-vscode/issues"
  },
  "qna": "https://github.com/wsj3000/devin-vscode/issues",
  "galleryBanner": {
    "color": "#1f1f1f",
    "theme": "dark"
  },
  "engines": {
    "vscode": "^1.93.0"
  },
  "categories": [
    "AI",
    "Chat",
    "Machine Learning",
    "Other"
  ],
  "keywords": [
    "devin",
    "devin-cli",
    "acp",
    "agent",
    "chat",
    "ai"
  ],
  "activationEvents": [
    "onWebviewPanel:devin.chatEditor",
    "onWebviewPanel:devin.settings"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "devin",
          "title": "Devin",
          "icon": "resources/activity-icon.svg"
        }
      ],
      "secondarySidebar": [
        {
          "id": "devinMaximized",
          "title": "Devin",
          "icon": "resources/activity-icon.svg"
        }
      ]
    },
    "views": {
      "devin": [
        {
          "type": "webview",
          "id": "devin.chatView",
          "name": "Chat"
        }
      ],
      "devinMaximized": [
        {
          "type": "webview",
          "id": "devin.maximizedChatView",
          "name": "Chat",
          "when": "devin.chatMaximized"
        }
      ]
    },
    "commands": [
      {
        "command": "devin.newSession",
        "title": "New Session",
        "category": "Devin",
        "icon": "$(add)"
      },
      {
        "command": "devin.newSessionEditor",
        "title": "New Session (Editor)",
        "category": "Devin",
        "icon": "$(split-horizontal)"
      },
      {
        "command": "devin.newSessionWindow",
        "title": "New Session (Window)",
        "category": "Devin",
        "icon": "$(multiple-windows)"
      },
      {
        "command": "devin.newSessionTerminal",
        "title": "New Devin CLI Session (Terminal)",
        "category": "Devin",
        "icon": "$(terminal)"
      },
      {
        "command": "devin.renameTabSession",
        "title": "Rename Session",
        "category": "Devin",
        "icon": "$(edit)"
      },
      {
        "command": "devin.showSessions",
        "title": "Session List",
        "category": "Devin",
        "icon": "$(history)"
      },
      {
        "command": "devin.focusChat",
        "title": "Open Chat",
        "category": "Devin",
        "icon": "$(comment-discussion)"
      },
      {
        "command": "devin.cancel",
        "title": "Cancel Current Turn",
        "category": "Devin",
        "icon": "$(stop-circle)"
      },
      {
        "command": "devin.switchSession",
        "title": "Switch to Session by Number",
        "category": "Devin",
        "icon": "$(list-ordered)"
      },
      {
        "command": "devin.runSetup",
        "title": "Run Setup",
        "category": "Devin",
        "icon": "$(gear)"
      },
      {
        "command": "devin.showInfo",
        "title": "About / Status",
        "category": "Devin",
        "icon": "$(info)"
      },
      {
        "command": "devin.openSettings",
        "title": "Open Settings",
        "category": "Devin",
        "icon": "$(gear)"
      },
      {
        "command": "devin.acceptChange",
        "title": "Accept Change",
        "category": "Devin",
        "icon": "$(check)"
      },
      {
        "command": "devin.rejectChange",
        "title": "Reject Change",
        "category": "Devin",
        "icon": "$(discard)"
      },
      {
        "command": "devin.acceptAllChanges",
        "title": "Accept All Changes",
        "category": "Devin",
        "icon": "$(check-all)"
      },
      {
        "command": "devin.rejectAllChanges",
        "title": "Reject All Changes",
        "category": "Devin",
        "icon": "$(discard)"
      },
      {
        "command": "devin.openChangeDiff",
        "title": "Open Diff",
        "category": "Devin",
        "icon": "$(diff)"
      },
      {
        "command": "devin.explainSelection",
        "title": "Devin: Explain This",
        "icon": "$(comment-discussion)"
      },
      {
        "command": "devin.fixProblemsHere",
        "title": "Devin: Fix Problems Here",
        "icon": "$(wrench)"
      },
      {
        "command": "devin.addFileToChat",
        "title": "Devin: Add File to Chat",
        "icon": "$(add)"
      }
    ],
    "keybindings": [
      {
        "command": "devin.showSessions",
        "key": "ctrl+k ctrl+d",
        "mac": "cmd+k cmd+d",
        "when": "!editorTextFocus"
      },
      {
        "command": "devin.switchSession",
        "key": "ctrl+1",
        "mac": "cmd+1",
        "args": 1,
        "when": "devin.chatFocused"
      },
      {
        "command": "devin.switchSession",
        "key": "ctrl+2",
        "mac": "cmd+2",
        "args": 2,
        "when": "devin.chatFocused"
      },
      {
        "command": "devin.switchSession",
        "key": "ctrl+3",
        "mac": "cmd+3",
        "args": 3,
        "when": "devin.chatFocused"
      },
      {
        "command": "devin.switchSession",
        "key": "ctrl+4",
        "mac": "cmd+4",
        "args": 4,
        "when": "devin.chatFocused"
      },
      {
        "command": "devin.switchSession",
        "key": "ctrl+5",
        "mac": "cmd+5",
        "args": 5,
        "when": "devin.chatFocused"
      },
      {
        "command": "devin.switchSession",
        "key": "ctrl+6",
        "mac": "cmd+6",
        "args": 6,
        "when": "devin.chatFocused"
      },
      {
        "command": "devin.switchSession",
        "key": "ctrl+7",
        "mac": "cmd+7",
        "args": 7,
        "when": "devin.chatFocused"
      },
      {
        "command": "devin.switchSession",
        "key": "ctrl+8",
        "mac": "cmd+8",
        "args": 8,
        "when": "devin.chatFocused"
      },
      {
        "command": "devin.switchSession",
        "key": "ctrl+9",
        "mac": "cmd+9",
        "args": 9,
        "when": "devin.chatFocused"
      }
    ],
    "menus": {
      "commandPalette": [
        {
          "command": "devin.acceptChange",
          "when": "false"
        },
        {
          "command": "devin.rejectChange",
          "when": "false"
        },
        {
          "command": "devin.openChangeDiff",
          "when": "false"
        },
        {
          "command": "devin.renameTabSession",
          "when": "false"
        },
        {
          "command": "devin.switchSession",
          "when": "false"
        }
      ],
      "editor/context": [
        {
          "command": "devin.explainSelection",
          "when": "editorHasSelection && editorLangId != 'Log'",
          "group": "devin@1"
        },
        {
          "command": "devin.fixProblemsHere",
          "when": "editorTextFocus && editorLangId != 'Log'",
          "group": "devin@2"
        },
        {
          "command": "devin.addFileToChat",
          "when": "editorTextFocus && !editorHasSelection",
          "group": "devin@3"
        }
      ],
      "explorer/context": [
        {
          "command": "devin.addFileToChat",
          "when": "!explorerResourceIsFolder",
          "group": "devin@1"
        }
      ],
      "editor/title/context": [
        {
          "command": "devin.renameTabSession",
          "when": "activeWebviewPanelId == 'devin.chatEditor'"
        }
      ],
      "scm/title": [
        {
          "command": "devin.acceptAllChanges",
          "when": "scmProvider == devin",
          "group": "navigation@1"
        },
        {
          "command": "devin.rejectAllChanges",
          "when": "scmProvider == devin",
          "group": "navigation@2"
        }
      ],
      "scm/resourceState/context": [
        {
          "command": "devin.acceptChange",
          "when": "scmProvider == devin",
          "group": "inline@1"
        },
        {
          "command": "devin.rejectChange",
          "when": "scmProvider == devin",
          "group": "inline@2"
        },
        {
          "command": "devin.openChangeDiff",
          "when": "scmProvider == devin",
          "group": "navigation@1"
        }
      ]
    },
    "configuration": {
      "title": "Devin",
      "properties": {
        "devin.cliPath": {
          "type": "string",
          "default": "devin",
          "description": "Path to the Devin CLI executable. Use an absolute path if it is not on your PATH."
        },
        "devin.defaultModel": {
          "type": "string",
          "default": "",
          "markdownDescription": "Model for chats started in this extension (e.g. `auto`, `sonnet`, `opus`, `gpt`). The model picker in the chat composer writes this setting, and it takes precedence over the Devin CLI's own default. Leave it empty to follow the CLI's `agent.model` instead, which you can set in **Devin: Open Settings**."
        },
        "devin.defaultThoughtLevel": {
          "type": "string",
          "enum": [
            "",
            "none",
            "low",
            "medium",
            "high",
            "xhigh"
          ],
          "enumDescriptions": [
            "Follow the model or Devin CLI default",
            "No extended thinking",
            "Low thinking effort",
            "Medium thinking effort",
            "High thinking effort",
            "Extra high thinking effort"
          ],
          "default": "",
          "markdownDescription": "Thinking effort for chats started in this extension. The thinking picker writes this setting when the Devin CLI exposes a `thought_level` session option."
        },
        "devin.defaultMode": {
          "type": "string",
          "enum": [
            "accept-edits",
            "smart",
            "ask",
            "plan",
            "bypass"
          ],
          "enumDescriptions": [
            "Code: write and edit code (auto-approves edits in the workspace)",
            "Smart: also auto-approve actions a fast model judges safe",
            "Ask: answer questions without code changes",
            "Plan: plan changes before implementing (read only)",
            "Bypass: auto-approve all tool calls"
          ],
          "default": "accept-edits",
          "markdownDescription": "Mode that chats started in this extension begin in. The picker in the chat composer offers whatever modes your Devin CLI reports, which may be more than are listed here."
        },
        "devin.sandbox": {
          "type": "boolean",
          "default": false,
          "markdownDescription": "Run the agent's commands in the Devin CLI's process sandbox (research preview), so they can only write inside the workspace and the paths you have granted. Applies to chats started after you change it. Needs `devin sandbox setup` to have been run once on this machine."
        },
        "devin.editorContext.diagnostics": {
          "type": "boolean",
          "default": true,
          "description": "Let Devin request diagnostics for a named file instead of running a compiler or a linter. Disable this to keep editor diagnostics out of chat."
        },
        "devin.autoResumeLast": {
          "type": "boolean",
          "default": false,
          "description": "When the chat opens, resume the last session used in this workspace."
        },
        "devin.idleSessionKeepAliveMinutes": {
          "type": "number",
          "default": 60,
          "minimum": 0,
          "description": "How long to keep an idle live session (waiting for you) alive before it is automatically exited. Running sessions are never auto-exited. Set to 0 to keep idle sessions alive indefinitely."
        },
        "devin.maxIdleSessions": {
          "type": "number",
          "default": 3,
          "minimum": 0,
          "description": "Maximum number of idle live sessions to keep. Running sessions are never auto-exited. Set to 0 to keep an unlimited number."
        },
        "devin.useIntegratedTerminal": {
          "type": "boolean",
          "default": false,
          "markdownDescription": "Run the agent's commands in a real VS Code terminal when enabled, so you can watch them, open them and take them over. Needs [shell integration](https://code.visualstudio.com/docs/terminal/shell-integration), which is on by default for bash, zsh, fish, pwsh and Git Bash. Commands fall back to running in the background when it is unavailable."
        },
        "devin.showMcpWarnings": {
          "type": "boolean",
          "default": true,
          "description": "Warn in the chat when an MCP server fails to start, so it is clear which tools the agent does not have."
        },
        "devin.showThinking": {
          "type": "boolean",
          "default": true,
          "description": "Show the agent's reasoning/thinking stream in the chat."
        },
        "devin.thinking.style": {
          "type": "string",
          "enum": [
            "collapsed",
            "fixedScrolling"
          ],
          "enumDescriptions": [
            "Show a collapsed 'Thinking…' header, and expand to read the reasoning",
            "Show a live, fixed height peek of the latest reasoning while it streams, then collapse it"
          ],
          "default": "fixedScrolling",
          "description": "How the reasoning stream is displayed while the agent is thinking."
        },
        "devin.incrementalRendering.animationStyle": {
          "type": "string",
          "enum": [
            "off",
            "fade",
            "rise",
            "blur",
            "scale",
            "slide"
          ],
          "default": "rise",
          "description": "Entrance animation for each response part as it streams in."
        },
        "devin.editRequests": {
          "type": "string",
          "enum": [
            "inline",
            "hover",
            "input",
            "none"
          ],
          "enumDescriptions": [
            "Click a sent message to edit it in place",
            "Show an edit button on hover, and editing happens in place",
            "Edit a sent message in the main composer at the bottom",
            "Disable editing sent messages"
          ],
          "default": "inline",
          "description": "How to edit a previously sent request. Editing rewinds the conversation to that point and re-runs (requires the Devin CLI revert capability)."
        },
        "devin.checkpoints.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Show a Restore Checkpoint action on each turn to rewind the workspace and conversation to that point (requires the Devin CLI revert capability)."
        },
        "devin.checkpoints.showFileChanges": {
          "type": "boolean",
          "default": true,
          "description": "Show a summary of files changed at the end of each turn."
        },
        "devin.editing.confirmEditRequestRemoval": {
          "type": "boolean",
          "default": true,
          "description": "Ask for confirmation before an edit or restore discards later turns that made file edits."
        },
        "devin.verbose": {
          "type": "boolean",
          "default": true,
          "description": "Show request and response timestamps on hover in the transcript."
        },
        "devin.progressBorder.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Animate a highlight around the input while Devin is working."
        },
        "devin.contextUsage.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Show the context window usage indicator in the input toolbar."
        },
        "devin.implicitContext.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Include the active editor file (or its selection) as implicit context, shown as a pill in the composer. Toggle it per message from the pill."
        },
        "devin.inlineReferences.style": {
          "type": "string",
          "enum": [
            "box",
            "link"
          ],
          "enumDescriptions": [
            "Render file and symbol references in replies as bordered chips",
            "Render them as plain text links"
          ],
          "default": "box",
          "description": "How file and symbol references inside replies are rendered."
        },
        "devin.sessionsPanel.side": {
          "type": "string",
          "enum": [
            "left",
            "right"
          ],
          "enumDescriptions": [
            "Dock the sessions panel on the left of the chat",
            "Dock the sessions panel on the right of the chat"
          ],
          "default": "right",
          "description": "Which side of the chat the docked sessions panel opens on. You can also drag the panel by its header to the other side."
        },
        "devin.sendWhileWorking": {
          "type": "string",
          "enum": [
            "queue",
            "stopAndSend"
          ],
          "enumDescriptions": [
            "Send the message after the current request finishes",
            "Stop what Devin is doing, then send the message"
          ],
          "default": "queue",
          "description": "What Enter does with a message typed while Devin is working. The other action is always on Alt+Enter, and on the chevron beside Send."
        },
        "devin.extraArgs": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "description": "Extra arguments passed to `devin acp` when starting a session."
        },
        "devin.env": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          },
          "default": {},
          "description": "Extra environment variables for the Devin CLI process (e.g. proxy settings)."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run build",
    "build": "node esbuild.js --production",
    "watch": "node esbuild.js --watch",
    "compile": "node esbuild.js",
    "check-types": "tsc --noEmit && tsc --noEmit -p scripts/tsconfig.json",
    "pretest": "npm run compile",
    "test": "node --test \"scripts/*.test.js\"",
    "pretest:one": "npm run compile",
    "test:one": "node --test",
    "harness": "node scripts/webview-harness.js",
    "probe": "node scripts/acp-probe.js",
    "preview": "npm run compile && node scripts/preview.js",
    "preview:settings": "npm run compile && node scripts/preview-settings.js",
    "package": "vsce package --no-dependencies",
    "publish:vsce": "vsce publish --no-dependencies",
    "publish:ovsx": "ovsx publish --no-dependencies"
  },
  "devDependencies": {
    "@types/markdown-it": "^14.1.2",
    "@types/node": "^20.14.0",
    "@types/vscode": "^1.93.0",
    "@vscode/codicons": "^0.0.46-23",
    "@vscode/vsce": "^3.9.2",
    "esbuild": "^0.23.1",
    "jsdom": "^25.0.1",
    "ovsx": "^1.0.2",
    "typescript": "^5.5.4"
  },
  "dependencies": {
    "highlight.js": "^11.10.0",
    "markdown-it": "^14.1.0",
    "mermaid": "^11.16.0"
  }
}
